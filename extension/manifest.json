{
  "manifest_version": 3,
  "name": "X Reply Autopilot Bridge",
  "version": "1.0.0",
  "description": "Streams tweets to local agent and posts autonomous replies",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "X Reply Autopilot"
  }
}
